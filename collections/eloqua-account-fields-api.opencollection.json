{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Eloqua Bulk Account Exports Account Fields API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Eloqua List account fields",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.p01.eloqua.com/API/Bulk/2.0/accounts/fields",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              }
            ]
          },
          "docs": "Retrieve all available account fields for use in export and import field mappings."
        }
      ]
    }
  ],
  "bundled": true
}