{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Eloqua Bulk Account Exports Custom Object Exports API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Object Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Eloqua List custom object export definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.p01.eloqua.com/API/Bulk/2.0/customObjects/:parentId/exports",
            "params": [
              {
                "name": "parentId",
                "value": "",
                "type": "path",
                "description": "The parent custom object identifier"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              }
            ]
          },
          "docs": "Retrieve all export definitions for a specific custom object."
        },
        {
          "info": {
            "name": "Oracle Eloqua Create a custom object export definition",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://secure.p01.eloqua.com/API/Bulk/2.0/customObjects/:parentId/exports",
            "params": [
              {
                "name": "parentId",
                "value": "",
                "type": "path",
                "description": "The parent custom object identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new export definition for a custom object."
        },
        {
          "info": {
            "name": "Oracle Eloqua List available custom objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure.p01.eloqua.com/API/Bulk/2.0/customObjects",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting index for pagination"
              }
            ]
          },
          "docs": "Retrieve all custom objects available for bulk operations."
        }
      ]
    }
  ],
  "bundled": true
}